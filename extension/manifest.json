{
  "manifest_version": 3,
  "name": "gh-switcher",
  "version": "1.0.0",
  "description": "Кнопки перехода из GitHub-репозитория в GitIngest и GitDiagram",
  "homepage_url": "https://github.com/Wwwoper/gh-switcher",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16_gray.png",
      "32": "icons/icon32_gray.png"
    },
    "default_title": "gh-switcher"
  },
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
